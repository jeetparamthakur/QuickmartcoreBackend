NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://param:param@localhost:5436/param
REDIS_URL=redis://127.0.0.1:6379
# Set SKIP_REDIS=true to run without Redis (disables background jobs)
SKIP_REDIS=false
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3007,http://localhost:8081,http://127.0.0.1:8081
SKIP_DB=false
# Optional. Auto-enabled when DATABASE_URL is a cloud host (Render, etc.).
# DB_SYNC_ON_START=true
GST_RATE=0
OTP_DEV_MODE=true

# Cloudinary — KYC documents are uploaded here; secure_url is stored in the DB.
# Create a free account at https://cloudinary.com and copy these from Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=QuickmartApp
